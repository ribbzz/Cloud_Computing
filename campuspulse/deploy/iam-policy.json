{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventAndUserTablesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:__REGION__:__ACCOUNT__:table/__EVENTS_TABLE__",
        "arn:aws:dynamodb:__REGION__:__ACCOUNT__:table/__EVENTS_TABLE__/index/*",
        "arn:aws:dynamodb:__REGION__:__ACCOUNT__:table/__USERS_TABLE__"
      ]
    },
    {
      "Sid": "BackupPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__",
        "arn:aws:s3:::__BUCKET__/backups/*"
      ]
    },
    {
      "Sid": "ReadOwnSecretOnly",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter__JWT_PARAM__"
    },
    {
      "Sid": "DecryptThatSecret",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {"kms:ViaService": "ssm.__REGION__.amazonaws.com"}
      }
    },
    {
      "Sid": "PublishOwnMetricsOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {"cloudwatch:namespace": "__METRIC_NS__"}
      }
    }
  ]
}
